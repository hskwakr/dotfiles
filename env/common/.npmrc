# pnpm: 新バージョン公開から7日間はインストール対象外 (10080分 = 7日)
minimum-release-age=10080

# npm: 11.10.0+ で有効 (現バージョンでは無視される先行設定)
min-release-age=7

# npm: install 時の preinstall / postinstall 等のライフサイクルスクリプトを実行しない
# native addon (node-gyp 系) のビルドも止まるため、必要なときだけ個別に戻す:
#   npm install --ignore-scripts=false
#   npm rebuild <pkg> --ignore-scripts=false  (インストール済みパッケージのビルドだけやり直す)
ignore-scripts=true
